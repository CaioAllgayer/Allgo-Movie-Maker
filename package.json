{
  "name": "allgo-movie-maker",
  "version": "1.0.0",
  "description": "Editor de vídeo desktop local, offline e minimalista — corte, crossfade, placas PNG e export NVENC.",
  "main": "out/main/main.js",
  "author": "Caio Allgayer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup": "node scripts/fetch-ffmpeg.mjs",
